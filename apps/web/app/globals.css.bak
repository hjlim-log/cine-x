@tailwind base;
@tailwind components;
@tailwind utilities;

body {
  background-color: #09090b;
  color: #ffffff;
  font-family: Arial, Helvetica, sans-serif;
}

@keyframes toast-enter {
  from { opacity: 0; transform: translateX(0.75rem); }
  to   { opacity: 1; transform: translateX(0); }
}

.toast-enter {
  animation: toast-enter 0.18s ease-out;
}
